# Normalisation des fins de ligne pour équipe mixte Linux/Windows
* text=auto eol=lf

# Scripts shell toujours en LF (sinon ils ne s'exécutent pas dans les conteneurs Linux)
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
