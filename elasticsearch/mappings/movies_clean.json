{
  "settings": {
    "analysis": {
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        }
      },
      "analyzer": {
        "movie_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "english_stop",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "movie_id": {
        "type": "integer"
      },
      "title": {
        "type": "text",
        "analyzer": "movie_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "overview": {
        "type": "text",
        "analyzer": "movie_analyzer"
      },
      "original_language": {
        "type": "keyword"
      },
      "release_date_ts": {
        "type": "date"
      },
      "popularity": {
        "type": "float"
      },
      "vote_average": {
        "type": "float"
      },
      "vote_count": {
        "type": "integer"
      }
    }
  }
}
