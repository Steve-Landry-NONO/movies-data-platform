{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "movie_title_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "movie_id": {
        "type": "integer"
      },
      "title": {
        "type": "text",
        "analyzer": "movie_title_analyzer",
        "fields": {
          "keyword": {
             "type": "keyword",
             "ignore_above": 256
          }
        }
      },
      "original_language": {
        "type": "keyword"
      },
      "release_date_ts": {
        "type": "date"
      },
      "popularity": {
        "type": "float"
      },
      "vote_average": {
        "type": "float"
      },
      "vote_count": {
        "type": "integer"
      },
      "overview": {
        "type": "text",
        "analyzer": "english"
      }
    }
  }
}
